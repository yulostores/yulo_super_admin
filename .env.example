# Origin of the YuloStores API. Leave blank in development to use the Vite dev
# proxy (see vite.config.js), which forwards /api to http://localhost:3000 and
# keeps the app same-origin so the refreshToken cookie is sent without CORS setup.
# Set this to the deployed API origin for production builds.
VITE_API_BASE=

# Where the dev server proxies /api to. Defaults to http://localhost:3000.
VITE_DEV_API_TARGET=
